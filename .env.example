# --- Flask ---
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-secret-string

# --- Database ---
# Local dev (sqlite, no setup needed):
DATABASE_URL=sqlite:///dev.db
# Production (Postgres, uncomment and configure):
# DATABASE_URL=postgresql://startupshowcase:password@db:5432/startupshowcase

# --- Superadmin bootstrap (created automatically on first run if missing) ---
SUPERADMIN_EMAIL=you@andrii-it.de
SUPERADMIN_PASSWORD=change-me

# --- Stripe: PLATFORM subscription (founder pays YOU for listing) ---
# This is YOUR Stripe account, separate from any founder's account.
STRIPE_PLATFORM_SECRET_KEY=sk_test_xxx
STRIPE_PLATFORM_PUBLISHABLE_KEY=pk_test_xxx
# From your Stripe Dashboard -> Developers -> Webhooks -> your endpoint ->
# "Signing secret". Required — the webhook route refuses unsigned events.
STRIPE_PLATFORM_WEBHOOK_SECRET=whsec_xxx

# One recurring Price per (tier, billing period), created in your own
# Stripe Dashboard -> Product catalog. Tiers are cumulative — see
# SubscriptionTier in app/models/subscription.py.
STRIPE_PLATFORM_PRICE_ID_PRESENTATION_MONTHLY=price_xxx
STRIPE_PLATFORM_PRICE_ID_PRESENTATION_ANNUAL=price_xxx
STRIPE_PLATFORM_PRICE_ID_AI_PITCH_MONTHLY=price_xxx
STRIPE_PLATFORM_PRICE_ID_AI_PITCH_ANNUAL=price_xxx
STRIPE_PLATFORM_PRICE_ID_PAYMENTS_MONTHLY=price_xxx
STRIPE_PLATFORM_PRICE_ID_PAYMENTS_ANNUAL=price_xxx

# --- Anthropic (pitch chatbot) ---
ANTHROPIC_API_KEY=sk-ant-xxx

# --- App ---
BASE_URL=http://localhost:5000
DEFAULT_LOCALE=en
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH_MB=15
